# Wardly Environment Configuration Template
# Copy this file to .env in wardly/backend/ and add your keys

# 1. Google Gemini AI Studio API Key (from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash

# 2. Leaflet / Map Tile Provider API Key (e.g. MapTiler, Mapbox, or Jawg)
# Optional: If not provided, Wardly uses free CartoDB Dark Matter tiles by default
LEAFLET_TILE_API_KEY=your_leaflet_tile_api_key_here
LEAFLET_TILE_PROVIDER=cartodb  # Options: cartodb, maptiler, mapbox

# 3. Security
WARDLY_SECRET_KEY=replace_with_a_long_random_secret

# Comma-separated browser origins permitted to call the API
WARDLY_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
